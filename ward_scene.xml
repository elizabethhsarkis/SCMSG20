<mujoco model="bedside ward">
  <!-- Robot first: the ROBOTIS Waffle Pi with our camera and LiDAR site [ROB] -->
  <include file="turtlebot3_waffle_pi_cam.xml"/>
 
  <!-- Viewer lighting and sky, copied from the ROBOTIS / UR3e scene files [ROB][UR3e] -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global offwidth="1280" offheight="960"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.62 0.64 0.66" rgb2="0.58 0.60 0.62" width="300" height="300"/>
    <material name="floor" texture="grid" texuniform="true" texrepeat="2 2"/>
    <!-- the ArUco picture made in make_marker_image() [T3-E] -->
    <texture type="2d" name="aruco" file="marker_assets/aruco_7.png"/>
    <material name="aruco" texture="aruco"/>
  </asset>
 
  <worldbody>
    <light pos="3 2 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor"/>
  <geom name="wall_S" type="box" pos="3.0 -0.05 0.25" size="3.0999999999999996 0.05 0.25" rgba="0.8 0.8 0.85 1" group="0"/>
  <geom name="wall_N" type="box" pos="3.0 4.05 0.25" size="3.0999999999999996 0.04999999999999982 0.25" rgba="0.8 0.8 0.85 1" group="0"/>
  <geom name="wall_W" type="box" pos="-0.05 2.0 0.25" size="0.05 2.0 0.25" rgba="0.8 0.8 0.85 1" group="0"/>
  <geom name="wall_E" type="box" pos="6.05 2.0 0.25" size="0.04999999999999982 2.0 0.25" rgba="0.8 0.8 0.85 1" group="0"/>
  <geom name="bed_A" type="box" pos="2.2 3.0 0.3" size="0.44999999999999996 1.0 0.3" rgba="0.8 0.8 0.85 1" group="0"/>
  <geom name="bed_B" type="box" pos="4.45 3.0 0.3" size="0.4500000000000002 1.0 0.3" rgba="0.8 0.8 0.85 1" group="0"/>
  <geom name="cabinet" type="box" pos="3.2875 3.65 0.25" size="0.2875000000000001 0.25 0.25" rgba="0.8 0.8 0.85 1" group="0"/>
  <geom name="trolley" type="box" pos="3.0999999999999996 1.0 0.45" size="0.30000000000000004 0.19999999999999996 0.45" rgba="0.8 0.8 0.85 1" group="0"/>

    <!-- ArUco marker: a flat plane on the cabinet face, facing -y into the ward.
         xyaxes="1 0 0 0 0 1": plane x along +x_W, plane y straight up, so its normal is -y_W.
         contype/conaffinity 0 and group 2: visible to the camera, invisible to physics and LiDAR [MJ] -->
    <geom name="aruco_marker" type="plane" pos="3.325 3.398 0.15"
          xyaxes="1 0 0 0 0 1" size="0.09 0.09 0.01" material="aruco"
          contype="0" conaffinity="0" group="2"/>
 
    <!-- Floor decals for the video: blue = pharmacy start, pink = dock goal (visual only) -->
    <geom type="cylinder" pos="0.6 0.6 0.001" size="0.15 0.001" rgba="0.2 0.6 0.9 0.5" contype="0" conaffinity="0" group="2"/>
    <geom type="cylinder" pos="3.325 2.999 0.001" size="0.12 0.001" rgba="0.9 0.3 0.6 0.5" contype="0" conaffinity="0" group="2"/>
  </worldbody>
 
  <!-- "home" keyframe, like the UR3e's [UR3e]. qpos = robot x y z, orientation quaternion
       (1 0 0 0 = facing +x), then the two wheel angles. Reset in the viewer returns here. -->
  <keyframe>
    <key name="home" qpos="0.6 0.6 0 1 0 0 0 0 0" ctrl="0 0"/>
  </keyframe>
</mujoco>
